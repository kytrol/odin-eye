      <None Include="packages.config" />
    </ItemGroup>
    <ItemGroup>
      <!-- Only pure logic is exercised here (NameBasedGuid, PeerExtensions,
      CharacterStatsController.IsValidStatValue). Referencing the whole
      OdinEye assembly is still safe even though this test project never
      loads BepInEx/Unity/Valheim: the CLR resolves an assembly lazily,
      only when a type from it is actually touched, and these tests never
      touch anything that calls into ZNet.instance/EnvMan.instance/
      ZDOMan.instance (ODINEYE-18; see that ticket for why the rest of
      OdinEye stays integration-tested only for now). -->
      <ProjectReference Include="..\OdinEye\OdinEye.csproj">
        <Project>{6bc0320e-49f2-4a19-be85-e909d6852c1c}</Project>
        <Name>OdinEye</Name>
      </ProjectReference>
      <ProjectReference Include="..\OdinEye.Models\OdinEye.Models.csproj">
        <Project>{0c64b257-49e8-4202-bb95-035170eaf5ec}</Project>
        <Name>OdinEye.Models</Name>
      </ProjectReference>
    </ItemGroup>
    <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
