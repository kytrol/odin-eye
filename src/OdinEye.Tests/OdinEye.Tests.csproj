    <ItemGroup>
        <Reference Include="mscorlib" />
        <Reference Include="nunit.framework, Version=3.14.0.0, Culture=neutral, PublicKeyToken=2638cd05610744eb, processorArchitecture=MSIL">
          <HintPath>..\..\packages\NUnit.3.14.0\lib\net45\nunit.framework.dll</HintPath>
        </Reference>
        <Reference Include="nunitlite, Version=3.14.0.0, Culture=neutral, PublicKeyToken=2638cd05610744eb, processorArchitecture=MSIL">
          <HintPath>..\..\packages\NUnitLite.3.14.0\lib\net45\nunitlite.dll</HintPath>
        </Reference>
        <!-- Same reasoning as OdinEye.Client.Tests.csproj's own copy of
        this reference: OdinEye.Models targets netstandard2.0, which needs
        a real, validly-signed netstandard.dll present at runtime under
        plain .NET Framework. -->
        <Reference Include="netstandard, Version=2.0.0.0, Culture=neutral, PublicKeyToken=cc7b13ffcd2ddd51, processorArchitecture=MSIL">
          <HintPath>..\..\packages\Microsoft.NETFramework.ReferenceAssemblies.net481.1.0.3\build\.NETFramework\v4.8.1\Facades\netstandard.dll</HintPath>
          <Private>true</Private>
        </Reference>
        <Reference Include="NGuid, Version=0.0.0.0, Culture=neutral, processorArchitecture=MSIL">
          <!-- Not used directly by any .cs file here: OdinEye.Models.dll
          is what actually calls into NGuid (NameBasedGuid). Kept as a
          direct reference purely so its CopyLocal lands NGuid.dll in
          $(TargetDir), since an old-style ProjectReference to an
          SDK-style netstandard2.0 project (OdinEye.Models) doesn't
          propagate ITS OWN NuGet dependencies into this project's
          output on its own, same reasoning as OdinEye.Client.csproj's/
          OdinEye.csproj's own identical NGuid reference. Confirmed
          live: without this, NameBasedGuid.NewPlayerGuid throws
          FileNotFoundException at test-run time despite compiling and
          building fine. -->
          <HintPath>..\..\packages\NGuid.0.2.0\lib\netstandard2.0\NGuid.dll</HintPath>
        </Reference>
        <Reference Include="System" />
        <Reference Include="System.Core" />
    </ItemGroup>
    <ItemGroup>
